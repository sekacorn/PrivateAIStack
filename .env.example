PRIVATE_AI_STACK_ENVIRONMENT=development
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=

DATABASE_URL=postgresql://private_ai_stack:private_ai_stack@postgres:5432/private_ai_stack
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

DEFAULT_PROFILE=laptop-cpu
MAX_WORKERS=1
MAX_AGENT_STEPS=6
TASK_TIMEOUT_SECONDS=120
REVIEW_TIMEOUT_SECONDS=180
ALLOW_DIRECT_OLLAMA_FALLBACK=false

OTEL_ENABLED=false
OTEL_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=private-ai-stack

AUDIT_DIR=audit
REPORTS_DIR=reports
EXPORT_DIR=exports
MAX_REVIEW_FILE_BYTES=250000
MAX_DOCUMENT_BYTES=1000000
MAX_DOCUMENT_CHUNKS=1000
MAX_AUDIT_RECORD_BYTES=64000
MAX_REQUEST_ID_CHARS=128
MAX_STATIC_TOOL_OUTPUT_BYTES=20000
ALLOW_HOSTED_PROVIDERS=false
EMBEDDING_DIMENSIONS=64
