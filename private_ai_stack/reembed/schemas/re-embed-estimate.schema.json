{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sekacorn/PrivateAIStack/schemas/re-embed-estimate.v1.json",
  "title": "re-embed-estimate.v1",
  "description": "A pre-run forecast for a re-embedding run. A forecast, not evidence: it is never read by exit-report, it carries no digest of itself, and it is deliberately not reproducible, because measured latency depends on the machine and its load at the time. records_to_embed is exact; everything else is extrapolated from the calibration sample. A null calibration means no sample was embedded and therefore nothing is estimated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_store",
    "target_model",
    "records_to_embed",
    "records_skipped",
    "calibration",
    "projection",
    "cost",
    "egress",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": "re-embed-estimate.v1"
    },
    "source_store": {
      "type": "object",
      "additionalProperties": false,
      "required": ["store_id", "store_evidence_sha256"],
      "properties": {
        "store_id": { "$ref": "#/$defs/identifier" },
        "store_evidence_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "target_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "dimensions"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "revision": { "$ref": "#/$defs/identifier" },
        "dimensions": { "type": "integer", "minimum": 1, "maximum": 8192 }
      }
    },
    "records_to_embed": {
      "description": "Exact: the retained record count in the source evidence document.",
      "type": "integer",
      "minimum": 0
    },
    "records_skipped": {
      "type": "object",
      "additionalProperties": false,
      "required": ["missing", "deleted_by_policy"],
      "properties": {
        "missing": { "type": "integer", "minimum": 0 },
        "deleted_by_policy": { "type": "integer", "minimum": 0 }
      }
    },
    "calibration": {
      "description": "What embedding the sample actually measured, or null when no sample was embedded.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sample_size",
            "sample_selection",
            "sample_seed",
            "tokenizer",
            "measured_tokens",
            "measured_source_bytes",
            "measured_latency_ms",
            "tokens_per_record",
            "latency_ms_per_record"
          ],
          "properties": {
            "sample_size": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "sample_selection": {
              "description": "How the sample was chosen, so a reader can repeat it.",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "sample_seed": { "type": "string", "minLength": 1, "maxLength": 128 },
            "tokenizer": {
              "description": "Whose tokenisation produced the counts. A whitespace fallback says so on its face.",
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "measured_tokens": { "type": "integer", "minimum": 0 },
            "measured_source_bytes": { "type": "integer", "minimum": 0 },
            "measured_latency_ms": { "type": "number", "minimum": 0 },
            "tokens_per_record": { "type": "number", "minimum": 0 },
            "latency_ms_per_record": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "projection": {
      "description": "The extrapolation to the full retained count, or null when there is no calibration.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "estimated_tokens", "estimated_latency_ms"],
          "properties": {
            "status": { "const": "estimated" },
            "estimated_tokens": { "type": "integer", "minimum": 0 },
            "estimated_latency_ms": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "cost": {
      "description": "AIMeter's output when a local cost profile was supplied and aimeter-oss was importable, otherwise a stated reason there is no money figure. Never computed here.",
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["estimated", "not_estimated"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 16 },
        "total_cost": { "type": "string" },
        "components": { "type": "object" },
        "assumptions": { "type": "string" },
        "source": { "type": "string" },
        "extrapolated_latency_ms": { "type": "number", "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "not_estimated" } }, "required": ["status"] },
          "then": { "required": ["reason"] }
        },
        {
          "if": { "properties": { "status": { "const": "estimated" } }, "required": ["status"] },
          "then": { "required": ["currency", "total_cost", "source"] }
        }
      ]
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remote_provider_used", "records_transmitted", "raw_source_text_transmitted"],
      "properties": {
        "remote_provider_used": { "type": "boolean" },
        "records_transmitted": { "type": "integer", "minimum": 0 },
        "raw_source_text_transmitted": { "type": "boolean" }
      }
    },
    "limits": {
      "description": "What this estimate does not claim, in plain words, always including that it is not a quotation.",
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "maxLength": 128
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
